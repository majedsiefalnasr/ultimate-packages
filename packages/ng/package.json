{
  "name": "@ultimate/ng",
  "version": "0.1.0",
  "description": "Ultimate Platform Angular components: Button, Checkbox, Dialog, Menu, Paginator, Scroller, Table, Tooltip.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/fesm2022/ultimate-ng.mjs",
  "module": "./dist/fesm2022/ultimate-ng.mjs",
  "types": "./dist/types/ultimate-ng.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/ultimate-ng.d.ts",
      "default": "./dist/fesm2022/ultimate-ng.mjs"
    },
    "./checkbox": {
      "types": "./dist/types/ultimate-ng-checkbox.d.ts",
      "default": "./dist/fesm2022/ultimate-ng-checkbox.mjs"
    },
    "./radio-button": {
      "types": "./dist/types/ultimate-ng-radio-button.d.ts",
      "default": "./dist/fesm2022/ultimate-ng-radio-button.mjs"
    },
    "./toggle-button": {
      "types": "./dist/types/ultimate-ng-toggle-button.d.ts",
      "default": "./dist/fesm2022/ultimate-ng-toggle-button.mjs"
    },
    "./toggle-switch": {
      "types": "./dist/types/ultimate-ng-toggle-switch.d.ts",
      "default": "./dist/fesm2022/ultimate-ng-toggle-switch.mjs"
    },
    "./paginator": {
      "types": "./dist/types/ultimate-ng-paginator.d.ts",
      "default": "./dist/fesm2022/ultimate-ng-paginator.mjs"
    },
    "./scroller": {
      "types": "./dist/types/ultimate-ng-scroller.d.ts",
      "default": "./dist/fesm2022/ultimate-ng-scroller.mjs"
    },
    "./tooltip": {
      "types": "./dist/types/ultimate-ng-tooltip.d.ts",
      "default": "./dist/fesm2022/ultimate-ng-tooltip.mjs"
    },
    "./autofocus": {
      "types": "./dist/types/ultimate-ng-autofocus.d.ts",
      "default": "./dist/fesm2022/ultimate-ng-autofocus.mjs"
    },
    "./badge": {
      "types": "./dist/types/ultimate-ng-badge.d.ts",
      "default": "./dist/fesm2022/ultimate-ng-badge.mjs"
    },
    "./fluid": {
      "types": "./dist/types/ultimate-ng-fluid.d.ts",
      "default": "./dist/fesm2022/ultimate-ng-fluid.mjs"
    },
    "./input-number": {
      "types": "./dist/types/ultimate-ng-input-number.d.ts",
      "default": "./dist/fesm2022/ultimate-ng-input-number.mjs"
    },
    "./textarea": {
      "types": "./dist/types/ultimate-ng-textarea.d.ts",
      "default": "./dist/fesm2022/ultimate-ng-textarea.mjs"
    },
    "./input-mask": {
      "types": "./dist/types/ultimate-ng-input-mask.d.ts",
      "default": "./dist/fesm2022/ultimate-ng-input-mask.mjs"
    },
    "./input-otp": {
      "types": "./dist/types/ultimate-ng-input-otp.d.ts",
      "default": "./dist/fesm2022/ultimate-ng-input-otp.mjs"
    },
    "./ripple": {
      "types": "./dist/types/ultimate-ng-ripple.d.ts",
      "default": "./dist/fesm2022/ultimate-ng-ripple.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": true,
  "dependencies": {
    "@ultimate/ng-core": "workspace:*",
    "@ultimate/uix-data": "workspace:*",
    "@ultimate/uix-motion": "workspace:*",
    "@ultimate/uix-styled": "workspace:*",
    "@ultimate/uix-styles": "workspace:*",
    "@ultimate/uix-utils": "workspace:*",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": "^21.2.22",
    "@angular/core": "^21.2.22",
    "@angular/forms": "^21.2.22",
    "@angular/platform-browser": "^21.2.22",
    "@angular/router": "^21.2.22",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.22",
    "@angular/cli": "21.2.22",
    "@angular/compiler-cli": "21.2.22",
    "@axe-core/playwright": "4.13.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/angular": "10.6.0",
    "@ultimate/themes": "workspace:*",
    "@vitest/coverage-v8": "4.0.8",
    "ng-packagr": "21.2.7",
    "storybook": "10.6.0",
    "typescript": "5.9.3",
    "vitest": "4.0.8"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "test": "ng test --project=ng",
    "test:coverage": "ng test --project=ng --coverage",
    "typecheck": "tsc --noEmit",
    "storybook": "ng run ng:storybook",
    "build-storybook": "ng run ng:build-storybook"
  }
}
