{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "experimentalDecorators": true,
    "target": "ES2022",
    "useDefineForClassFields": false,
    "baseUrl": ".",
    "paths": {
      "@ultimate/ng/*": ["src/*/index.ts"]
    }
  },
  "include": ["src"],
  "angularCompilerOptions": {
    "strictTemplates": true
  }
}
