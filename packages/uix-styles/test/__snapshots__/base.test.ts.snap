// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`base styles > matches the known snapshot 1`] = `
"
    .u-collapsible-enter-active {
        animation: u-animate-collapsible-expand 0.2s ease-out;
        overflow: hidden;
    }

    .u-collapsible-leave-active {
        animation: u-animate-collapsible-collapse 0.2s ease-out;
        overflow: hidden;
    }

    @keyframes u-animate-collapsible-expand {
        from {
            grid-template-rows: 0fr;
        }
        to {
            grid-template-rows: 1fr;
        }
    }

    @keyframes u-animate-collapsible-collapse {
        from {
            grid-template-rows: 1fr;
        }
        to {
            grid-template-rows: 0fr;
        }
    }

    .u-disabled,
    .u-disabled * {
        cursor: default;
        pointer-events: none;
        user-select: none;
    }

    .u-disabled,
    .u-component:disabled {
        opacity: dt('disabled.opacity');
    }

    .u-icon {
        width: dt('icon.size');
        height: dt('icon.size');
    }

    .u-overlay-mask {
        background: dt('mask.background');
        color: dt('mask.color');
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .u-overlay-mask-enter-active {
        animation: u-animate-overlay-mask-enter dt('mask.transition.duration') forwards;
    }

    .u-overlay-mask-leave-active {
        animation: u-animate-overlay-mask-leave dt('mask.transition.duration') forwards;
    }

    @keyframes u-animate-overlay-mask-enter {
        from {
            background: transparent;
        }
        to {
            background: dt('mask.background');
        }
    }
    @keyframes u-animate-overlay-mask-leave {
        from {
            background: dt('mask.background');
        }
        to {
            background: transparent;
        }
    }

    .u-anchored-overlay-enter-active {
        animation: u-animate-anchored-overlay-enter 300ms cubic-bezier(.19,1,.22,1);
    }

    .u-anchored-overlay-leave-active {
        animation: u-animate-anchored-overlay-leave 300ms cubic-bezier(.19,1,.22,1);
    }

    @keyframes u-animate-anchored-overlay-enter {
        from {
            opacity: 0;
            transform: scale(0.93);
        }
    }

    @keyframes u-animate-anchored-overlay-leave {
        to {
            opacity: 0;
            transform: scale(0.93);
        }
    }
"
`;
