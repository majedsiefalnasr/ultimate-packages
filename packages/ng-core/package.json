{
  "name": "@ultimate/ng-core",
  "version": "0.1.0",
  "description": "Angular-specific foundation for the Ultimate Platform: base component hierarchy, overlay/focus-trap infrastructure, icons, minimal config.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/fesm2022/ultimate-ng-core.mjs",
  "module": "./dist/fesm2022/ultimate-ng-core.mjs",
  "types": "./dist/types/ultimate-ng-core.d.ts",
  "files": [
    "dist",
    "README.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": true,
  "dependencies": {
    "@ultimate/uix-styled": "workspace:*",
    "@ultimate/uix-utils": "workspace:*",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": "^21.2.22",
    "@angular/core": "^21.2.22",
    "@angular/forms": "^21.2.22",
    "@angular/platform-browser": "^21.2.22",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.22",
    "@angular/cli": "21.2.22",
    "@angular/compiler-cli": "21.2.22",
    "@vitest/coverage-v8": "4.0.8",
    "ng-packagr": "21.2.7",
    "typescript": "5.9.3",
    "vitest": "4.0.8"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "test": "ng test --project=ng-core",
    "test:coverage": "ng test --project=ng-core --coverage",
    "typecheck": "tsc --noEmit"
  }
}
